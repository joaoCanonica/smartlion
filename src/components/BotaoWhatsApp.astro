---
import { linkWhatsApp, mensagemGeral } from '../config/whatsapp';
interface Props { texto?: string; rotulo?: string; flutuante?: boolean; discreto?: boolean; compacto?: boolean }
const { texto = mensagemGeral, rotulo = 'Fale conosco', flutuante = false, discreto = false, compacto = false } = Astro.props;
---
<a class:list={['button','button-wa',{flutuante,discreto,compacto}]} href={linkWhatsApp(texto)} aria-label={flutuante ? 'Conversar com a Smart Lion no WhatsApp' : undefined}>
  <svg width="20" height="20" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.5-4.6A9 9 0 1 1 21 11.5Z"/><path d="M8 7c0 5 4 9 9 9l1-3-3-1-1 1-3-3 1-1-1-3Z"/></svg>
  <span>{rotulo}</span>
</a>
<style>
.discreto{background:transparent;color:var(--cor-texto);border-color:var(--cor-linha);font-weight:400}.discreto svg{color:var(--cor-whatsapp)}
.compacto{min-height:44px;padding:.55rem 1rem;font-size:.85rem}.compacto svg{width:18px;height:18px}
.flutuante{overflow:visible;position:fixed;right:24px;bottom:24px;z-index:30;width:52px;height:52px;min-height:52px;padding:0;border-radius:var(--raio-md);box-shadow:var(--sombra-3);border:1px solid rgb(8 43 22 / .6)}
.flutuante span{position:absolute;right:calc(100% + 12px);padding:8px 14px;background:var(--cor-superficie);color:var(--cor-texto);border:1px solid var(--vidro-borda);border-radius:var(--raio-sm);white-space:nowrap;font-size:.8rem;opacity:0;pointer-events:none;transform:translateX(5px);transition:opacity .15s,transform .15s}
.flutuante:hover span,.flutuante:focus-visible span{opacity:1;transform:none}
@media(max-width:700px){.flutuante{right:16px;bottom:16px}}
</style>
