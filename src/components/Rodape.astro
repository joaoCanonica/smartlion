---
import { loja, enderecoCompleto } from '../config/loja';
import { formatarPeriodos } from '../lib/horario';
import { linkWhatsApp, mensagemGeral } from '../config/whatsapp';
import { navegacao, atividades } from '../config/navegacao';
import AvaliarGoogle from './avaliacoes/AvaliarGoogle.astro';
import StatusHorario from './StatusHorario.astro';
import Logo from './marca/Logo.astro';
import Rotulo from './ui/Rotulo.astro';
const paginas = [...navegacao, ...atividades, { nome: 'Perguntas frequentes', href: '/perguntas-frequentes' }, { nome: 'Dicas', href: '/dicas' }, { nome: 'Privacidade', href: '/privacidade' }];
---
<footer id="contato" class="rodape">
  <Logo variante="leao" decorativo class="rodape-marca-dagua"/>
  <div class="container rodape-topo">
    <Logo variante="completo" titulo={`${loja.nome} · ${loja.endereco.cidade}/${loja.endereco.uf}`} class="rodape-logo"/>
    <p class="rodape-assinatura">Tecnologia de verdade é sobre pessoas.</p>
  </div>
  <div class="container rodape-colunas">
    <section aria-labelledby="rodape-loja">
      <Rotulo as="h2" id="rodape-loja" tom="ambar">Loja</Rotulo>
      <address>{enderecoCompleto}<br/>CEP {loja.endereco.cep}</address>
      <ul class="rodape-links"><li><a href={loja.googleMaps}>Ver no Google Maps ↗</a></li><li><a href={loja.instagram.url}>Instagram {loja.instagram.nome} ↗</a></li></ul>
    </section>
    <section aria-labelledby="rodape-horario">
      <Rotulo as="h2" id="rodape-horario" tom="ambar">Horário</Rotulo>
      <StatusHorario link={false} anunciar={false} class="rodape-status"/>
      <table><caption class="sr-only">Horário de atendimento</caption><tbody>{loja.horario.semana.map(h => <tr><th scope="row">{h.rotulo}</th><td>{formatarPeriodos(h.periodos)}</td></tr>)}</tbody></table>
      <p class="rodape-nota">Nos feriados, consulte o atendimento.</p>
    </section>
    <section aria-labelledby="rodape-contato">
      <Rotulo as="h2" id="rodape-contato" tom="ambar">Contato</Rotulo>
      <a class="rodape-contato" href={linkWhatsApp(mensagemGeral)}><span class="rotulo rotulo-aco">WhatsApp</span><span class="rodape-numero">{loja.whatsapp.exibicao}</span></a>
      <a class="rodape-contato" href={`tel:${loja.telefone.numero}`}><span class="rotulo rotulo-aco">Telefone</span><span class="rodape-numero">{loja.telefone.exibicao}</span></a>
    </section>
    <nav aria-labelledby="rodape-paginas" id="paginas-rodape">
      <Rotulo as="h2" id="rodape-paginas" tom="ambar">Páginas</Rotulo>
      <ul class="rodape-paginas">{paginas.map(n => <li><a href={n.href}>{n.nome}</a></li>)}</ul>
    </nav>
  </div>
  <AvaliarGoogle compacto/>
  <div class="container rodape-base">
    <p>{loja.nome} · {loja.endereco.cidade}/{loja.endereco.uf}{loja.cnpj && ` · CNPJ ${loja.cnpj}`}{loja.razaoSocial && ` · ${loja.razaoSocial}`}{import.meta.env.DEV && !loja.cnpj && <span class="pendente"> · CNPJ PENDENTE</span>}</p>
    <button class="preferencias-button" type="button" data-preferencias hidden>Preferências de privacidade</button>
    <p>Desenvolvido por WAXLO</p>
  </div>
</footer>
<style>
.rodape{position:relative;isolation:isolate;overflow:hidden;padding:var(--espaco-secao) 0 100px;background:var(--cor-fundo);color:var(--cor-texto);border-top:1px solid var(--cor-borda)}
.rodape :global(.rodape-marca-dagua){position:absolute;z-index:-1;right:-14%;bottom:-18%;width:min(78vw,980px);height:auto;color:var(--cor-texto);opacity:.05;pointer-events:none}
.rodape-topo{display:flex;align-items:center;gap:clamp(20px,3vw,40px);margin-bottom:clamp(48px,6vw,80px)}
.rodape-topo :global(.rodape-logo){width:clamp(72px,8vw,104px);flex:none}
.rodape-assinatura{font:var(--peso-titulo) clamp(1.6rem,1.1rem + 2.2vw,3rem)/1.08 var(--fonte-titulo);letter-spacing:var(--tracking-titulo);max-width:16ch;text-wrap:balance}
.rodape-colunas{display:grid;grid-template-columns:1fr 1.2fr .9fr 1.4fr;gap:clamp(32px,4vw,56px);color:var(--cor-texto-2);font-size:var(--texto-sm)}
.rodape-colunas :global(h2){margin-bottom:18px}
.rodape-colunas section,.rodape-colunas nav{padding-top:20px;border-top:1px solid var(--cor-borda)}
address{font-style:normal;margin-bottom:14px;color:var(--cor-texto)}
.rodape-links,.rodape-paginas{list-style:none;margin:0;padding:0}
.rodape-links a,.rodape-paginas a{display:inline-flex;align-items:center;min-height:40px}
.rodape-paginas{columns:2;column-gap:24px}.rodape-paginas li{break-inside:avoid}.rodape-paginas a{color:var(--cor-texto)}
.rodape-paginas a:hover,.rodape-links a:hover,.rodape-contato:hover .rodape-numero{color:var(--cor-acento);text-decoration:none}
.rodape-colunas :global(.rodape-status){margin:0 0 14px;min-height:0;color:var(--cor-texto)}
table{border-collapse:collapse;font-variant-numeric:tabular-nums}
th{text-align:left;font-weight:400;padding:0 16px 10px 0;vertical-align:top}
td{padding-bottom:10px;color:var(--cor-texto)}
.rodape-nota{font-size:.78rem;margin-top:6px}
.rodape-contato{display:grid;gap:4px;margin-bottom:20px}
.rodape-contato:hover{text-decoration:none}
.rodape-numero{color:var(--cor-texto);font:500 1.2rem/1.2 var(--fonte-titulo);font-variant-numeric:tabular-nums;letter-spacing:-.01em;transition:color var(--duracao-curta)}
.rodape :global(.avaliar.compacto){background:transparent;margin-top:clamp(48px,6vw,72px)}
.rodape :global(.avaliar.compacto>.container){padding-top:clamp(32px,4vw,48px);border-top:1px solid var(--cor-borda)}
.rodape-base{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;padding-top:24px;border-top:1px solid var(--cor-borda);font-size:.78rem;color:var(--cor-texto-2)}
.preferencias-button{min-height:44px;padding:10px 16px;color:var(--cor-texto);background:transparent;border:1px solid var(--cor-linha);border-radius:var(--raio-sm);font-size:.8rem}
.preferencias-button:hover{border-color:var(--cor-texto)}
.pendente{color:#ffda8b}
@media(max-width:1024px){.rodape-colunas{grid-template-columns:1fr 1fr}}
@media(max-width:600px){
  .rodape-topo{flex-direction:column;align-items:flex-start}
  .rodape-colunas{grid-template-columns:1fr;gap:28px}
  .rodape :global(.rodape-marca-dagua){width:150vw;right:-55%;bottom:-6%}
  .rodape-base{flex-direction:column;align-items:flex-start}
}
</style>
