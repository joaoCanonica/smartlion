---
/**
 * Abertura "O Rugido de Luz" · parte 1 (vai no INÍCIO do conteúdo da home).
 *
 * Script inline e síncrono: decide se a abertura roda e, se rodar, cria na hora a
 * camada Preto Leão com grão e o botão "Pular" (visíveis desde o 1º quadro).
 * Não roda com prefers-reduced-motion, sem JS (nada é criado) ou se a abertura já
 * passou nesta sessão (sessionStorage, com try/catch).
 * O hero continua no HTML e é pintado por baixo; o SVG e a animação chegam depois,
 * pela parte 2 (AberturaModelo.astro), colocada depois do hero.
 */
---
<script is:inline>
(function () {
  try {
    var chave = 'smartlion-rugido-v1', html = document.documentElement;
    if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try { if (sessionStorage.getItem(chave)) return; sessionStorage.setItem(chave, '1'); } catch (e) { /* sem armazenamento: roda e segue */ }
    var raiz = document.createElement('div');
    raiz.className = 'rugido';
    raiz.setAttribute('data-rugido', '');
    raiz.setAttribute('data-t0', String(performance.now()));
    raiz.innerHTML = '<div class="rugido-fundo"></div><button type="button" class="rugido-pular" data-rugido-pular>Pular<span class="sr-only"> abertura</span></button>';
    document.body.insertBefore(raiz, document.body.firstChild);
    html.classList.add('rugido-ativo');
    var pular = function () {
      if (window.__slAberturaPular) return window.__slAberturaPular();
      if (raiz.parentNode) raiz.parentNode.removeChild(raiz);
      html.classList.remove('rugido-ativo');
    };
    // Clique, toque, tecla ou rolagem pulam. Tab e modificadoras não: Tab leva ao "Pular".
    raiz.addEventListener('click', pular);
    addEventListener('keydown', function (e) { if (raiz.parentNode && !/^(Tab|Shift|Control|Alt|Meta|CapsLock)$/.test(e.key)) pular(); });
    addEventListener('wheel', function () { if (raiz.parentNode) pular(); }, { passive: true });
    addEventListener('touchmove', function () { if (raiz.parentNode) pular(); }, { passive: true });
    // Segurança: se a animação não começar (script bloqueado/erro), a camada some.
    setTimeout(function () { if (!raiz.hasAttribute('data-iniciada')) pular(); }, 3500);
  } catch (e) { /* abertura é decorativa: qualquer erro mantém a página como está */ }
})();
</script>
<style is:global>
.rugido{position:fixed;inset:0;z-index:100;display:grid;place-items:center;color:var(--cor-texto);overflow:hidden;cursor:pointer}
.rugido-fundo{position:absolute;inset:0;background:var(--cor-fundo)}
.rugido-fundo::after{content:'';position:absolute;inset:0;background-image:var(--grao);background-size:160px;opacity:var(--grao-opacidade);pointer-events:none}
.rugido-logo{position:relative;width:min(62vmin,460px);height:auto;overflow:visible;transform-origin:0 0;will-change:transform}
.rugido-logo .ab-letra,.rugido-logo .ab-parte,.rugido-logo .ab-varredura{opacity:0}
.rugido-logo .ab-leao{transform-box:fill-box;transform-origin:center}
.rugido-pular{position:absolute;z-index:2;right:var(--margem-lateral);bottom:max(20px,env(safe-area-inset-bottom));display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 16px;background:rgb(23 24 27 / .6);color:var(--cor-texto);border:1px solid var(--vidro-borda);border-radius:var(--raio-sm);font:400 .7rem/1 var(--fonte-rotulo);letter-spacing:.16em;text-transform:uppercase;cursor:pointer}
.rugido-pular::after{content:'';width:8px;height:8px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:rotate(45deg)}
.rugido-pular:hover{border-color:var(--cor-texto-2)}
.rugido-pular:focus-visible{outline:2px solid var(--cor-foco);outline-offset:3px}
</style>
