---
import { Picture } from 'astro:assets';
import type { Produto } from '../../lib/catalogo';
interface Props { produto: Produto; indice?: number }
const { produto, indice = 0 } = Astro.props;
const imagem = produto.imagens[indice];
---
<div class="foto-produto">
 {imagem ? <Picture src={imagem} alt={produto.imagensAlt[indice]} formats={['avif','webp']} widths={[320,480,720]} sizes="(max-width: 700px) 90vw, 40vw" width={720} height={720} fit="contain" loading="lazy"/> : <div class="slot-imagem"><span class="eyebrow">{produto.categoria === 'ipad-mac-watch' ? 'TABLET / APPLE' : produto.categoria === 'acessorios' ? 'ACESSÓRIO' : 'CELULAR'}</span><span class="slot-marca" aria-hidden="true">SL</span><span>Foto a definir</span><small>Slot de demonstração</small></div>}
</div>
<style>
.foto-produto{aspect-ratio:1;background:var(--cor-superficie-2);overflow:hidden;border-radius:var(--raio-md)}
.foto-produto :global(img){width:100%;height:100%;object-fit:contain}
.foto-produto :global(picture){display:block;width:100%;height:100%}
.slot-imagem{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;color:var(--cor-texto-2);border:1px dashed var(--cor-linha);border-radius:inherit;gap:5px;padding:18px;text-align:center;background:repeating-linear-gradient(135deg,rgb(154 158 166 / .07) 0 1px,transparent 1px 12px)}
.slot-marca{font:400 clamp(2.4rem,6vw,4.5rem)/1.4 var(--fonte-rotulo);color:var(--cor-borda)}
.slot-imagem .eyebrow{font-size:.6rem}.slot-imagem small{font-size:.7rem}
</style>
