---
import '../../styles/produto.css';
---
<p class="sr-only" data-modal-feedback role="status" aria-live="polite"></p>
<dialog id="modal-produto" aria-labelledby="modal-titulo"><div class="modal-barra"><span>SMART LION</span><button type="button" data-fechar-modal aria-label="Fechar opções do produto" autofocus>Fechar <span aria-hidden="true">×</span></button></div><div data-modal-conteudo></div></dialog>
<script src="../../scripts/modal-produto.ts"></script>
<style>
dialog{border:1px solid var(--vidro-borda);border-radius:var(--raio-lg);padding:0;width:min(1040px,calc(100% - 32px));max-height:calc(100dvh - 32px);background:var(--cor-superficie);color:var(--cor-texto);box-shadow:var(--sombra-3);overflow:auto}
dialog::backdrop{background:rgb(11 11 12 / .85);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.modal-barra{position:sticky;top:0;background:var(--cor-superficie);border-bottom:1px solid var(--cor-borda);z-index:2;display:flex;align-items:center;justify-content:space-between;padding:12px 24px;font:400 .7rem/1 var(--fonte-rotulo);letter-spacing:.14em;text-transform:uppercase;color:var(--cor-texto-2)}
.modal-barra button{min-height:44px;min-width:85px;background:transparent;color:var(--cor-texto);border:1px solid var(--cor-linha);border-radius:var(--raio-sm);padding:8px 12px}
.modal-barra span[aria-hidden]{margin-left:12px;font-size:1.2rem}
@media(max-width:700px){dialog{width:calc(100% - 16px);max-height:calc(100dvh - 16px)}.modal-barra{padding:8px 20px}}
</style>
