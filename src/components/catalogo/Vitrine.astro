---
import { obterProdutos } from '../../lib/produtos';
import CardProduto from './CardProduto.astro';

const produtos=(await obterProdutos()).filter(p=>p.destaque).slice(0,8);
---
<section class="vitrine light"><div class="container"><div class="titulo-vitrine"><div><p class="eyebrow">Explore as opções</p><h2>Na sua próxima escolha.</h2></div><a href="/produtos">Ver catálogo completo ↗</a></div>{import.meta.env.DEV&&<p class="aviso">Prévia: slots de demonstração, fora do build de produção.</p>}{produtos.length === 0 && <p class="sob-consulta">Seu próximo aparelho começa com uma conversa. Consulte os modelos disponíveis, versões e condições com a equipe.</p>}<div class="grade">{produtos.map(p=><CardProduto produto={p}/>)}</div></div></section>
<style>.vitrine{padding:60px 0}.titulo-vitrine{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}.titulo-vitrine .eyebrow{color:var(--cor-acento-escuro);margin-bottom:14px}.titulo-vitrine a{font-size:.8rem;white-space:nowrap}.aviso{font-size:.8rem;color:#633a00;margin-bottom:20px}.grade{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 24px}@media(max-width:1000px){.grade{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.titulo-vitrine{display:block}.titulo-vitrine a{display:inline-block;margin-top:18px}.grade{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:420px){.grade{grid-template-columns:1fr}}</style>
