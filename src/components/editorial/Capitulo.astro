---
/** Capítulo editorial. tema: 'preto' (Preto Leão, padrão) ou 'grafite' — as páginas alternam os dois. */
interface Props { id: string; tema?: 'preto'|'grafite'; marcador?: string; titulo: string }
const {id,tema='preto',marcador,titulo}=Astro.props;
---
<section id={id} class:list={['capitulo',{'grafite':tema==='grafite'}]} aria-labelledby={`${id}-titulo`}><div class="container"><header>{marcador&&<p class="eyebrow">{marcador}</p>}<h2 id={`${id}-titulo`}>{titulo}</h2><div class="introducao"><slot name="introducao"/></div></header><slot/></div></section>
<style>
.capitulo{padding-block:var(--espaco-secao);background:var(--cor-fundo);color:var(--cor-texto)}
.capitulo.grafite{background:var(--cor-superficie)}
header{margin-bottom:clamp(32px,5vw,64px);max-width:1000px}
.eyebrow{color:var(--cor-acento);margin-bottom:18px}
h2{max-width:20ch}
.introducao{max-width:660px;margin-top:20px;color:var(--cor-texto-2)}
</style>
