---
/**
 * Faixa de prova logo abaixo do hero. Todos os valores vêm da config e das avaliações
 * coletadas (nada digitado aqui). IRP: rótulo curto + a descrição oficial da config.
 */
import { loja } from '../../config/loja';
import { resumoAvaliacoes, atualizadoEm } from '../../lib/avaliacoes';
import NumeroContador from '../ui/NumeroContador.astro';
---
<section class="prova" aria-label="A Smart Lion em números">
  <ul class="container prova-lista">
    <li>
      <a class="prova-item" href="/avaliacoes">
        <span class="prova-numero"><NumeroContador valor={resumoAvaliacoes.nota} casas={1}/> <span aria-hidden="true">★</span><span class="sr-only">de 5</span></span>
        <span class="prova-texto"><NumeroContador valor={resumoAvaliacoes.total}/> avaliações no Google</span>
        <span class="prova-nota">Coleta de {atualizadoEm}</span>
      </a>
    </li>
    <li>
      <a class="prova-item" href="/assistencia-tecnica">
        <span class="prova-numero prova-sigla">IRP Apple</span>
        <span class="prova-texto">{loja.irpDescricao}</span>
      </a>
    </li>
    <li>
      <a class="prova-item" href="/seminovos">
        <span class="prova-numero"><NumeroContador valor={loja.garantiaSeminovosMeses}/> meses</span>
        <span class="prova-texto">de garantia da loja nos seminovos</span>
      </a>
    </li>
  </ul>
</section>
<style>
.prova{border-block:1px solid var(--cor-borda);background:linear-gradient(180deg,rgb(23 24 27 / .55),rgb(11 11 12 / 0))}
.prova-lista{list-style:none;margin-block:0;padding:0;display:grid;grid-template-columns:1fr 1.5fr 1fr}
.prova-lista li+li{border-left:1px solid var(--cor-borda)}
.prova-lista a{display:grid;align-content:start;gap:6px;height:100%;padding:clamp(20px,2.5vw,32px) clamp(16px,2.5vw,36px)}
.prova-lista li:first-child a{padding-left:0}
.prova-lista a:hover{text-decoration:none}
.prova-lista a:hover .prova-numero{color:var(--cor-texto)}
.prova-numero{font:400 clamp(1.3rem,.9rem + 1.6vw,2.4rem)/1.1 var(--fonte-rotulo);white-space:nowrap;color:var(--cor-acento);letter-spacing:.02em;font-variant-numeric:tabular-nums;transition:color var(--duracao-curta)}
.prova-sigla{letter-spacing:.06em}
.prova-texto{font-size:var(--texto-sm);color:var(--cor-texto)}
.prova-nota{font-size:.75rem;color:var(--cor-texto-2)}
@media (max-width:800px){
  .prova-lista{grid-template-columns:1fr 1fr}
  .prova-lista li:nth-child(2){grid-column:1 / -1;grid-row:2;border-left:0;border-top:1px solid var(--cor-borda)}
  .prova-lista li:nth-child(2) a{padding-left:0}
  .prova-lista li:nth-child(3){border-left:1px solid var(--cor-borda)}
}
</style>
