---
/**
 * "Chegou na loja": carrossel horizontal com rolagem nativa (scroll-snap), 3–6 itens da
 * coleção src/content/destaques. Sem preço. Em produção só aparecem itens confirmados;
 * sem nenhum, a seção inteira não é renderizada. Em dev, itens sem confirmação aparecem
 * marcados como PROVISÓRIO.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { destaquePublicavel } from '../../schemas/destaque';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';
import Rotulo from '../ui/Rotulo.astro';
const todos = (await getCollection('destaques')).map(e => e.data).sort((a, b) => a.ordem - b.ordem);
const itens = todos.filter(d => import.meta.env.DEV || destaquePublicavel(d)).slice(0, 6);
---
{itens.length > 0 && (
  <section class="chegou" id="chegou" aria-labelledby="titulo-chegou">
    <div class="container chegou-cabecalho">
      <div>
        <Rotulo tom="ambar">Chegou na loja</Rotulo>
        <h2 id="titulo-chegou">Novidades na vitrine.</h2>
      </div>
      <p>Disponibilidade, versões e cores mudam rápido: confirme com a equipe pelo WhatsApp.</p>
    </div>
    {import.meta.env.DEV && itens.some(d => !destaquePublicavel(d)) && <p class="container pendente">PROVISÓRIO: itens sem confirmação da loja (confirmadoEm vazio) não aparecem em produção.</p>}
    <div class="container">
      <ul class="chegou-trilho" tabindex="0" aria-label="Novidades. Role para o lado para ver mais.">
        {itens.map((d, i) => (
          <li class="chegou-item">
            <figure class="chegou-foto">
              {d.foto ? <Picture src={d.foto} alt={d.fotoAlt} formats={['avif', 'webp']} widths={[360, 560, 720]} sizes="(max-width: 700px) 78vw, 340px" loading="lazy"/>
                : <div class="chegou-sem-foto" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span></div>}
              {import.meta.env.DEV && !destaquePublicavel(d) && <figcaption class="pendente">PROVISÓRIO{d.foto ? '' : ' · sem foto'}</figcaption>}
            </figure>
            <div class="chegou-corpo">
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
              <BotaoWhatsApp texto={d.mensagemWhatsApp} rotulo="Consultar disponibilidade" discreto/>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
.chegou{padding-block:var(--espaco-secao) calc(var(--espaco-secao) * .6)}
.chegou-cabecalho{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:32px}
.chegou-cabecalho h2{margin-top:14px}
.chegou-cabecalho>p{max-width:20.81em;color:var(--cor-texto-2)}
.chegou-trilho{list-style:none;margin:0;padding:0 0 18px;display:grid;grid-auto-flow:column;grid-auto-columns:min(78%,340px);gap:20px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--cor-borda) transparent}
.chegou-item{scroll-snap-align:start;display:grid;grid-template-rows:auto 1fr;background:var(--cor-superficie);border:1px solid var(--cor-borda);border-radius:var(--raio-lg);overflow:hidden}
.chegou-foto{margin:0;position:relative;aspect-ratio:4/5;background:var(--cor-superficie-2)}
.chegou-foto :global(img){width:100%;height:100%;object-fit:cover}
.chegou-sem-foto{position:absolute;inset:0;display:grid;place-items:end start;padding:20px;background:repeating-linear-gradient(135deg,rgb(154 158 166 / .07) 0 1px,transparent 1px 12px),radial-gradient(circle at 70% 30%,rgb(227 168 87 / .14),transparent 60%)}
.chegou-sem-foto span{font:400 3rem/1 var(--fonte-rotulo);color:var(--cor-texto-2)}
.chegou-corpo{display:grid;align-content:start;gap:12px;padding:20px}
.chegou-corpo h3{font-size:var(--texto-h4)}
.chegou-corpo p{color:var(--cor-texto-2);font-size:var(--texto-sm)}
.chegou-corpo :global(.button){margin-top:6px;justify-self:start}
.pendente{font-size:.75rem;background:#fff0c7;color:#633a00;padding:10px 12px;margin-bottom:16px}
figcaption.pendente{position:absolute;left:12px;top:12px;margin:0}
@media (max-width:700px){.chegou-cabecalho{display:block}.chegou-cabecalho>p{margin-top:14px}}
</style>
