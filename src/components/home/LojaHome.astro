---
/**
 * Visite-nos (home, /a-loja, /visite-nos e /como-chegar).
 * - Fachada quando houver (loja.fotoFachada). Sem fachada, a home e /a-loja não repetem a
 *   foto do interior (já usada na página); só /visite-nos (`pagina`) a mantém até a P6.
 * - Horário ao vivo (StatusHorario), tabela, rotas, contatos e mapa com consentimento
 *   (scripts/mapa.ts: os ganchos data-mapa, .consentimento, [data-aceitar-mapa],
 *   [data-recusar-mapa], .status-mapa e .mapa-conteudo continuam iguais).
 */
import { Picture } from 'astro:assets';
import { midia } from '../../lib/midia';
import { loja, enderecoCompleto } from '../../config/loja';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';
import StatusHorario from '../StatusHorario.astro';
import Rotulo from '../ui/Rotulo.astro';
import { formatarPeriodos } from '../../lib/horario';
interface Props { pagina?: boolean }
const { pagina = false } = Astro.props;
const TituloDetalhe = pagina ? 'h2' : 'h3';
const coordenadas = `${loja.coordenadas.latitude},${loja.coordenadas.longitude}`;
const mapa = `https://www.google.com/maps?q=${encodeURIComponent(coordenadas)}&z=17&output=embed`;
const waze = `https://www.waze.com/ul?ll=${encodeURIComponent(coordenadas)}&navigate=yes`;
const mostrarInterior = pagina && !loja.fotoFachada;
---
<section class="visite" id="visite-nos" aria-labelledby="titulo-loja">
  <div class="container">
    <span id="loja" aria-hidden="true"></span>
    <div class="visite-cabecalho">
      <div>
        {pagina ? <>
          <h1 id="titulo-loja">Visite a Smart Lion em Lages.</h1>
          <p class="resposta">Nossa loja fica na {loja.endereco.rua}, {loja.endereco.numero}, no Centro de {loja.endereco.cidade}. Confira o horário antes de sair e fale com a equipe pelo WhatsApp se precisar de orientação.</p>
          <a class="atalho" href="#horarios-e-rotas">Ver horários e rotas ↓</a>
        </> : <>
          <Rotulo tom="ambar">Tem endereço. Tem gente.</Rotulo>
          <h2 id="titulo-loja">Visite-nos. Vamos conversar.</h2>
        </>}
      </div>
      <address>{enderecoCompleto}<br/>CEP {loja.endereco.cep}</address>
    </div>
    {mostrarInterior && <Picture class="visite-foto" src={midia.loja} formats={['avif', 'webp']} widths={[480, 800, 1280]} sizes="100vw" alt="Interior da Smart Lion, com balcão de madeira e prateleiras iluminadas" loading="lazy"/>}
    {import.meta.env.DEV && !loja.fotoFachada && <p class="pendente">PROVISÓRIO: aguardando foto da fachada{mostrarInterior ? '; por enquanto, foto do interior' : ''}.</p>}
    <div class="detalhes" id="horarios-e-rotas">
      <div class="detalhes-horario">
        <TituloDetalhe>Quando visitar</TituloDetalhe>
        <StatusHorario link={false} anunciar={false} class="visite-status"/>
        <table><caption class="sr-only">Horário da loja em Lages</caption><tbody>{loja.horario.semana.map(h => <tr><th scope="row">{h.rotulo}</th><td>{formatarPeriodos(h.periodos)}</td></tr>)}</tbody></table>
        <p class="nota">Nos feriados, confirme o atendimento com a equipe.</p>
        <div class="rotas"><a class="button" href={loja.googleMaps}>Google Maps ↗</a><a class="button" href={waze}>Waze ↗</a></div>
        <div class="contatos"><BotaoWhatsApp rotulo="Fale conosco no WhatsApp"/><a href={`tel:${loja.telefone.numero}`}>Telefone: {loja.telefone.exibicao}</a></div>
      </div>
      <div class="mapa" data-mapa={mapa}>
        <TituloDetalhe>Encontre a Smart Lion</TituloDetalhe>
        <p>Ao carregar o mapa, seu navegador se conecta ao Google, que pode usar cookies. Você pode continuar com o endereço e os links de rota sem carregar o mapa aqui.</p>
        <div class="consentimento" hidden><button class="button" type="button" data-aceitar-mapa>Carregar mapa do Google</button><button class="button" type="button" data-recusar-mapa>Continuar sem mapa</button></div>
        <p class="status-mapa" role="status"></p>
        <div class="mapa-conteudo"></div>
        <noscript><p>Use os links Google Maps ou Waze para abrir a rota.</p></noscript>
      </div>
    </div>
  </div>
</section>
<script>import '../../scripts/mapa';</script>
<style>
.visite{padding-block:var(--espaco-secao);border-top:1px solid var(--cor-borda)}
.visite-cabecalho{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:clamp(28px,4vw,48px)}
.visite-cabecalho h1{max-width:11.34em}
.visite-cabecalho h2{margin-top:14px;max-width:10.58em}
.resposta{max-width:34.68em;margin:24px 0;color:var(--cor-texto-2)}
.atalho{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:.28em}
address{font-style:normal;line-height:1.8;color:var(--cor-texto-2);text-align:right}
.visite :global(.visite-foto img){width:100%;height:clamp(240px,30vw,420px);object-fit:cover;border-radius:var(--raio-md);margin-bottom:clamp(28px,4vw,48px)}
.detalhes{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:clamp(20px,3vw,40px);scroll-margin-top:6rem}
.detalhes-horario,.mapa{padding:clamp(20px,3vw,36px);border:1px solid var(--vidro-borda);border-radius:var(--raio-lg);background:var(--vidro-bg)}
.detalhes h2,.detalhes h3{font-size:var(--texto-h4);margin-bottom:14px}
.detalhes-horario :global(.visite-status){margin:0 0 14px;min-height:0}
table{border-collapse:collapse;font-variant-numeric:tabular-nums}
th{text-align:left;font-weight:400;padding:8px 24px 8px 0;color:var(--cor-texto-2)}
td{padding:8px 0}
.nota,.mapa p{font-size:.85rem;color:var(--cor-texto-2);margin:14px 0}
.rotas,.consentimento{display:flex;flex-wrap:wrap;gap:12px;margin-top:16px}
.consentimento .button{flex:1;min-width:180px}
.contatos{display:grid;justify-items:start;gap:12px;margin-top:20px}
.contatos>a{display:flex;align-items:center;min-height:44px;color:var(--cor-texto)}
.mapa :global(iframe){display:block;width:100%;height:320px;border:0;border-radius:var(--raio-md)}
.status-mapa:empty{display:none}
.pendente{background:#fff0c7;color:#633a00;padding:12px;font-size:.8rem;margin-bottom:20px}
@media (max-width:800px){.visite-cabecalho{display:block}address{margin-top:18px;text-align:left}.detalhes{grid-template-columns:1fr}}
</style>
