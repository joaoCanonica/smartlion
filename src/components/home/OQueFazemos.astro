---
/**
 * O que fazemos: 4 painéis de vidro (2×2 no desktop, empilhados no celular), com número
 * em Michroma, foto real, título e link. No hover a foto acende e a varredura passa pela borda.
 * Fotos: cada uma aparece uma única vez na home (ver docs/premium/P4.md). Seminovos ainda
 * não tem foto real dos aparelhos: painel gráfico com a garantia, PROVISÓRIO em dev.
 */
import { Picture } from 'astro:assets';
import { loja } from '../../config/loja';
import { midia } from '../../lib/midia';
import Rotulo from '../ui/Rotulo.astro';
const pilares = [
  { numero: '01', titulo: 'Produtos para a sua rotina.', texto: 'Apple, Xiaomi e importados. A gente conversa sobre o que você procura e ajuda na escolha.', href: '/produtos', link: 'Conheça os produtos', foto: midia.fones, alt: 'Fone de ouvido azul fotografado na loja Smart Lion' },
  { numero: '02', titulo: 'Seminovos com\u00a0procedência.', texto: `Nossos iPhones seminovos passam por avaliação técnica e têm ${loja.garantiaSeminovosMeses} meses de garantia.`, href: '/seminovos', link: 'Conheça os seminovos', foto: null, alt: '' },
  { numero: '03', titulo: 'Cuidado técnico, de perto.', texto: `${loja.irpDescricao}.`, href: '/assistencia-tecnica', link: 'Conheça a assistência', foto: midia.bancada, alt: 'Microscópio e ferramentas na bancada técnica da Smart Lion' },
  { numero: '04', titulo: 'Um espaço para aprender.', texto: 'Teoria e prática no Centro Técnico, com bancadas individuais para o treinamento de manutenção de celulares.', href: '/curso-manutencao-celular', link: 'Conheça o curso', foto: midia.laboratorio, alt: 'Bancadas individuais do Centro Técnico da Smart Lion' },
];
---
<section class="fazemos" id="atividades" aria-labelledby="titulo-fazemos">
  <div class="container">
    <header class="fazemos-cabecalho">
      <Rotulo tom="ambar">O que fazemos</Rotulo>
      <h2 id="titulo-fazemos">Diferentes caminhos. O mesmo cuidado.</h2>
      <p class="fazemos-ideia">Queremos tornar a experiência com tecnologia segura e confiável. <span>Procedência na escolha.</span> <span>Atendimento de perto.</span> <span>Suporte depois da compra.</span></p>
    </header>
    <div class="fazemos-grade">
      {pilares.map(p => (
        <article class="pilar">
          <div class="pilar-midia">
            {p.foto ? <Picture src={p.foto} alt={p.alt} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 45vw" loading="lazy"/>
              : <div class="pilar-grafico" aria-hidden="true"><span class="pilar-grafico-numero">{loja.garantiaSeminovosMeses}</span><span class="pilar-grafico-rotulo">meses de garantia da loja</span></div>}
            {import.meta.env.DEV && !p.foto && <p class="pendente">PROVISÓRIO: aguardando foto real dos seminovos.</p>}
          </div>
          <div class="pilar-corpo">
            <span class="pilar-numero" aria-hidden="true">{p.numero}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
            <a class="pilar-link" href={p.href}>{p.link} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
.fazemos{padding-block:var(--espaco-secao)}
.fazemos-cabecalho{display:grid;grid-template-columns:1fr 1fr;gap:16px 64px;align-items:end;margin-bottom:clamp(36px,5vw,64px)}
.fazemos-cabecalho :global(.rotulo){grid-column:1 / -1}
.fazemos-cabecalho h2{max-width:10.58em}
.fazemos-ideia{color:var(--cor-texto-2);font-size:var(--texto-lg);max-width:25.43em}
.fazemos-ideia span{color:var(--cor-texto)}
.fazemos-grade{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2vw,28px)}
.pilar{position:relative;isolation:isolate;display:grid;grid-template-rows:auto 1fr;background:var(--vidro-bg);border:1px solid var(--vidro-borda);border-radius:var(--raio-lg);overflow:hidden;-webkit-backdrop-filter:var(--vidro-desfoque);backdrop-filter:var(--vidro-desfoque)}
/* Varredura na borda: gradiente animado recortado para 1 px de borda. */
.pilar::after{content:'';position:absolute;inset:0;z-index:3;pointer-events:none;border-radius:inherit;padding:1px;background:linear-gradient(110deg,transparent 35%,rgb(227 168 87 / .9) 47%,#F5F6F7 50%,rgb(227 168 87 / .9) 53%,transparent 65%) 120% 0/300% 100% no-repeat;-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0}
.pilar:hover::after,.pilar:focus-within::after{opacity:1;animation:pilar-borda 1.1s var(--ease-saida) 1 both}
@keyframes pilar-borda{from{background-position:120% 0}to{background-position:-20% 0}}
.pilar-midia{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--cor-superficie-2)}
.pilar-midia :global(picture),.pilar-midia :global(img){display:block;width:100%;height:100%}
.pilar-midia :global(img){object-fit:cover;filter:brightness(.72) saturate(.85);transform:scale(1.001);transition:filter .6s var(--ease-saida),transform .9s var(--ease-saida)}
.pilar:hover .pilar-midia :global(img),.pilar:focus-within .pilar-midia :global(img){filter:brightness(1.04) saturate(1);transform:scale(1.045)}
.pilar-grafico{position:absolute;inset:0;display:grid;align-content:end;gap:8px;padding:clamp(20px,3vw,32px);background:repeating-linear-gradient(120deg,rgb(154 158 166 / .08) 0 1px,transparent 1px 14px),radial-gradient(circle at 80% 20%,rgb(227 168 87 / .16),transparent 55%),var(--cor-superficie)}
.pilar-grafico-numero{font:400 clamp(4rem,9vw,7.5rem)/.9 var(--fonte-rotulo);color:var(--cor-acento)}
.pilar-grafico-rotulo{font:400 var(--texto-rotulo)/1.4 var(--fonte-rotulo);letter-spacing:var(--tracking-rotulo);text-transform:uppercase;color:var(--cor-texto-2)}
.pilar-corpo{display:grid;align-content:start;gap:12px;padding:clamp(20px,2.5vw,32px)}
.pilar-numero{font:400 .8rem/1 var(--fonte-rotulo);letter-spacing:.16em;color:var(--cor-acento)}
.pilar-corpo h3{font-size:var(--texto-h3)}
.pilar-corpo p{color:var(--cor-texto-2);max-width:26.59em}
.pilar-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;justify-self:start;color:var(--cor-texto);text-decoration:underline;text-decoration-color:rgb(154 158 166 / .55);text-underline-offset:.28em}
/* O painel inteiro é clicável pelo link (um só alvo de foco). */
.pilar-link::before{content:'';position:absolute;inset:0;z-index:2}
.pilar-link:hover{color:var(--cor-acento);text-decoration-color:var(--cor-acento)}
.pendente{position:absolute;left:12px;bottom:12px;z-index:1;font-size:.75rem;background:#fff0c7;color:#633a00;padding:8px 10px}
@media (max-width:800px){.fazemos-cabecalho{grid-template-columns:1fr}.fazemos-grade{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){.pilar:hover::after,.pilar:focus-within::after{opacity:0}}
</style>
