---
import { loja } from '../../config/loja';
import { mensagensWhatsApp } from '../../config/whatsapp';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';
---
<section class="parcelamento grafite" id="parcelamento" aria-labelledby="titulo-parcelamento"><div class="container"><div><p class="eyebrow rotulo-ambar">Consulte as condições para o seu aparelho</p><h2 id="titulo-parcelamento">Planeje a próxima compra.</h2><div class="opcoes"><p><strong>Até {loja.parcelamento.cartaoAte}x</strong><span>no cartão</span></p><p><strong>Até {loja.parcelamento.boletoAte}x</strong><span>no boleto, sujeito a análise de crédito</span></p></div><p class="nota">Consulte entrada, taxas, valor das parcelas e condições vigentes antes de fechar.</p></div><BotaoWhatsApp texto={mensagensWhatsApp.parcelamento()} rotulo="Simular no WhatsApp"/></div></section>
<style>.parcelamento{padding-block:var(--espaco-secao)}.container{display:flex;align-items:center;justify-content:space-between;gap:32px}.eyebrow{margin-bottom:18px}h2{font-size:var(--texto-h2)}.opcoes{display:flex;gap:clamp(24px,5vw,64px);margin:32px 0}.opcoes p{display:grid;gap:8px;padding-top:16px;border-top:1px solid var(--cor-acento)}.opcoes strong{font:400 clamp(2rem,1.2rem + 3vw,3.5rem)/1 var(--fonte-rotulo);color:var(--cor-texto);font-variant-numeric:tabular-nums}.opcoes span,.nota{font-size:var(--texto-sm);color:var(--cor-texto-2)}.nota{max-width:600px}.container :global(.button){flex-shrink:0}@media(max-width:850px){.container{display:block}.container :global(.button){margin-top:28px}}</style>
