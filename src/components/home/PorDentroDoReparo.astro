---
/**
 * "Por dentro do reparo" na home. O conteúdo interativo (abas de serviço, painel e aparelho
 * 3D/ilustração) é o componente src/components/reparo3d/Reparo3D.astro (P5).
 */
import { loja } from '../../config/loja';
import Rotulo from '../ui/Rotulo.astro';
import Reparo3D from '../reparo3d/Reparo3D.astro';
---
<section class="reparo" id="reparo" aria-labelledby="titulo-reparo">
  <div class="container">
    <header class="reparo-cabecalho">
      <div>
        <Rotulo tom="ambar">Assistência técnica</Rotulo>
        <h2 id="titulo-reparo">Por dentro do reparo.</h2>
      </div>
      <p>{loja.irpDescricao}. Escolha a parte do aparelho para ver o serviço e pedir um orçamento.</p>
    </header>
    <Reparo3D id="reparo-home"/>
    <a class="link-editorial reparo-todos" href="/assistencia-tecnica">Todos os serviços de assistência ↗</a>
  </div>
</section>
<style>
.reparo{padding-block:var(--espaco-secao);background:linear-gradient(180deg,var(--cor-fundo),var(--cor-superficie) 30%,var(--cor-superficie) 70%,var(--cor-fundo));border-block:1px solid var(--cor-borda)}
.reparo-cabecalho{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:clamp(28px,4vw,48px)}
.reparo-cabecalho h2{margin-top:14px}
.reparo-cabecalho>p{max-width:25.43em;color:var(--cor-texto-2)}
.reparo-todos{margin-top:24px}
@media (max-width:800px){.reparo-cabecalho{display:block}.reparo-cabecalho>p{margin-top:14px}}
</style>
