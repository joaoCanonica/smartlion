---
/**
 * Ilustração vetorial em camadas (fallback do reparo 3D e versão padrão no celular).
 * Celular GENÉRICO, sem desenho de marca: vidro, tela, bateria, placa e tampa traseira.
 * As camadas estão desenhadas na vista explodida; montadas, cada uma recebe --dy em CSS
 * (Reparo3D.astro) e fica junto das outras. A camada escolhida acende em âmbar.
 */
interface Props { id: string }
const { id } = Astro.props;
// Camadas de cima para baixo; desenhadas de baixo para cima (a última fica por cima).
const camadas = [
  { id: 'vidro', rotulo: 'Vidro' },
  { id: 'tela', rotulo: 'Tela' },
  { id: 'bateria', rotulo: 'Bateria' },
  { id: 'placa', rotulo: 'Placa' },
  { id: 'tampa', rotulo: 'Tampa traseira' },
];
const X = 270, Y0 = 34, PASSO = 64; // posição de cada camada na vista explodida
const M = 'matrix(0.9 0.45 -0.9 0.45 0 0)'; // projeção oblíqua do plano do aparelho (140 × 260)
---
<svg class="reparo-camadas" viewBox="0 0 680 520" width="680" height="520" role="img" aria-labelledby={`${id}-titulo`}>
        <title id={`${id}-titulo`}>Ilustração das camadas de um celular, de cima para baixo: vidro, tela, bateria, placa e tampa traseira.</title>
        <defs>
          <linearGradient id={`${id}-grad-tela`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#222429"/><stop offset=".55" stop-color="#0B0B0C"/><stop offset="1" stop-color="#17181B"/></linearGradient>
          <linearGradient id={`${id}-grad-vidro`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F5F6F7" stop-opacity=".16"/><stop offset=".5" stop-color="#F5F6F7" stop-opacity=".03"/><stop offset="1" stop-color="#E3A857" stop-opacity=".10"/></linearGradient>
        </defs>
        {[...camadas].reverse().map((c, i) => {
          const y = Y0 + (camadas.length - 1 - i) * PASSO;
          return (
            <g class={`camada camada-${c.id} camada-pos-${i}`}>
              <g transform={`translate(${X} ${y})`}><g transform={M}>
                {c.id === 'tampa' && <>
                  <rect width="140" height="260" rx="22" fill="#17181B" stroke="#9A9EA6" stroke-opacity=".55"/>
                  <rect x="12" y="12" width="46" height="46" rx="12" fill="#222429" stroke="#9A9EA6" stroke-opacity=".5"/>
                  <circle cx="26" cy="26" r="8" fill="#0B0B0C" stroke="#9A9EA6" stroke-opacity=".7"/><circle cx="44" cy="44" r="8" fill="#0B0B0C" stroke="#9A9EA6" stroke-opacity=".7"/>
                </>}
                {(c.id === 'placa' || c.id === 'bateria') && <rect width="140" height="260" rx="22" fill="none" stroke="#9A9EA6" stroke-opacity=".28" stroke-dasharray="3 5"/>}
                {c.id === 'placa' && <>
                  <rect x="8" y="8" width="124" height="96" rx="10" fill="#222429" stroke="#9A9EA6" stroke-opacity=".55"/>
                  <rect x="22" y="22" width="34" height="26" rx="3" fill="#0B0B0C" stroke="#E3A857" stroke-opacity=".7"/>
                  <rect x="66" y="22" width="22" height="22" rx="3" fill="#0B0B0C" stroke="#9A9EA6" stroke-opacity=".6"/>
                  <rect x="96" y="24" width="24" height="56" rx="3" fill="#0B0B0C" stroke="#9A9EA6" stroke-opacity=".6"/>
                  <path d="M22 66h60M22 76h44M22 86h66M56 35h10" stroke="#E3A857" stroke-opacity=".55" fill="none"/>
                </>}
                {c.id === 'bateria' && <>
                  <rect x="18" y="98" width="104" height="144" rx="10" fill="#222429" stroke="#9A9EA6" stroke-opacity=".6"/>
                  <path d="M38 170h64M70 138v64" stroke="#9A9EA6" stroke-opacity=".35"/>
                </>}
                {c.id === 'tela' && <rect width="140" height="260" rx="22" fill={`url(#${id}-grad-tela)`} stroke="#9A9EA6" stroke-opacity=".6"/>}
                {c.id === 'vidro' && <>
                  <rect width="140" height="260" rx="22" fill={`url(#${id}-grad-vidro)`} stroke="#F5F6F7" stroke-opacity=".55"/>
                  <path d="M24 40 L74 10 M18 84 L104 30" stroke="#F5F6F7" stroke-opacity=".28" stroke-width="2"/>
                </>}
              </g></g>
              <path class="camada-linha" d={`M${X + 126 + 6} ${y + 63}H440`}/>
              <text class="camada-rotulo" x="448" y={y + 67}>{c.rotulo.toUpperCase()}</text>
            </g>
          );
        })}
      </svg>
<ol class="reparo-legenda" aria-hidden="true">{camadas.map(c => <li data-camada-legenda={c.id}>{c.rotulo}</li>)}</ol>
