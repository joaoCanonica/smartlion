---
import '../styles/tokens.css';
import '../styles/global.css';
import { redirects } from '../../vercel.json';
import Header from '../components/Header.astro';
import Rodape from '../components/Rodape.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import PendenciasDev from '../components/PendenciasDev.astro';
import { getImage } from 'astro:assets';
import { midia } from '../lib/midia';
const fotoLoja = midia.loja;
import Consentimento from '../components/Consentimento.astro';
import { dadosEstruturados, jsonSeguro, urlCanonica, podeIndexar } from '../lib/seo';
import type { Produto } from '../lib/catalogo';
interface Props { title: string; description: string; produto?: Produto }
const { title, description, produto } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const destination = redirects.find(rule => rule.source === path)?.destination ?? path;
const canonical = urlCanonica(destination, Astro.site!);
const indexavel=podeIndexar(import.meta.env.DEV,import.meta.env.PUBLIC_INDEXABLE,import.meta.env.VERCEL_ENV)&&!Astro.url.pathname.startsWith('/404')&&!Astro.url.pathname.startsWith('/_estilo')&&!Astro.url.pathname.startsWith('/_estudo');
const og=await getImage({src:fotoLoja,width:1200,format:'jpg'});
const schema=dadosEstruturados(destination,title,Astro.site!,produto);
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexavel ? 'index,follow' : 'noindex,nofollow'}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:locale" content="pt_BR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(og.src,Astro.site).href}/><meta property="og:image:alt" content="Interior da loja Smart Lion em Lages"/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={jsonSeguro(schema)}/><meta name="theme-color" content="#0B0B0C"/><meta name="color-scheme" content="dark"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/manifest.webmanifest"/></head><body><span class="topo-sentinela" data-topo-sentinela aria-hidden="true"></span><a class="skip" href="#conteudo">Pular para o conteúdo</a><div class="sticky"><Header/></div><PendenciasDev/><main id="conteudo" tabindex="-1"><slot/></main><Consentimento/><Rodape/><aside class="atendimento-flutuante" aria-label="Atendimento pelo WhatsApp"><BotaoWhatsApp flutuante/></aside></body></html>
<style>.sticky{position:sticky;top:0;z-index:40}main:focus{outline:none}.topo-sentinela{position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none}</style>
