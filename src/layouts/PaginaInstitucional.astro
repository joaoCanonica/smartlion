---
/**
 * Páginas institucionais: cabeçalho com <Rotulo> + título grande + parágrafo-resposta,
 * sobre o Preto Leão com grão (o do body). Foto ou visual opcional à direita (slot "foto").
 * Os capítulos da página alternam Preto Leão (.pagina-bloco) e Grafite (.pagina-bloco.grafite);
 * Branco Gelo (.claro) só em páginas de texto longo.
 */
import Layout from './LayoutBase.astro';
import Rotulo from '../components/ui/Rotulo.astro';
import '../styles/institucional.css';
interface Props { titulo:string; descricao:string; resposta:string; rotulo?:string; editorial?:boolean }
const { titulo,descricao,resposta,rotulo='Smart Lion · Lages',editorial=false }=Astro.props;
---
<Layout title={`${titulo} | Smart Lion`} description={descricao}>
  <header class:list={['pagina-abertura', 'container', { editorial }]}>
    <nav aria-label="Caminho da página"><a href="/">Início</a> <span aria-hidden="true">/</span> <span aria-current="page">{titulo}</span></nav>
    <div class="abertura-corpo">
      <div class="abertura-texto">
        <Rotulo tom="ambar">{rotulo}</Rotulo>
        <h1>{titulo}</h1>
        <p class="resposta">{resposta}</p>
        <slot name="acao"/>
      </div>
      <slot name="foto"/>
    </div>
  </header>
  <slot/>
</Layout>
