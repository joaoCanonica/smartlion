---
import Layout from './LayoutBase.astro';
import '../styles/institucional.css';
interface Props { titulo:string; descricao:string; resposta:string; rotulo?:string; editorial?:boolean }
const { titulo,descricao,resposta,rotulo='Smart Lion · Lages',editorial=false }=Astro.props;
---
<Layout title={`${titulo} | Smart Lion`} description={descricao}>
  <header class:list={['pagina-abertura', 'container', { editorial }]}>
    <nav aria-label="Caminho da página"><a href="/">Início</a> / <span aria-current="page">{titulo}</span></nav>
    <div class="abertura-corpo">
      <div>
        {!editorial && <p class="eyebrow">{rotulo}</p>}
        <h1>{titulo}</h1>
        <p class="resposta">{resposta}</p>
        <slot name="acao"/>
      </div>
      <slot name="foto"/>
    </div>
  </header>
  <slot/>
</Layout>
<style>
  .editorial nav {border-bottom:1px solid var(--wood);padding-bottom:1rem}
  .editorial h1 {max-width:20ch}
  .editorial .resposta {max-width:62ch}
  .abertura-corpo:has(figure) {display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:clamp(2rem,6vw,6rem);align-items:center}
  .abertura-corpo :global(figure) {margin:0}
  .abertura-corpo :global(figure img) {width:100%;height:auto;aspect-ratio:5/4;object-fit:cover}
  .abertura-corpo :global(figcaption) {color:var(--wood-light);font-size:.85rem;padding-top:.6rem}
  @media(max-width:800px){.abertura-corpo:has(figure){grid-template-columns:1fr}}
</style>
