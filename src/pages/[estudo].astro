---
export function getStaticPaths(){ return [{params:{estudo:"_estilo"}}]; }
import Layout from '../layouts/LayoutBase.astro';
import Capitulo from '../components/editorial/Capitulo.astro';
import RevelacaoImagem from '../components/editorial/RevelacaoImagem.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import StatusHorario from '../components/StatusHorario.astro';
import { Picture } from 'astro:assets';
import { midia } from '../lib/midia';
const lojaFoto = midia.loja;
const bancada = midia.bancada;
const laboratorio = midia.laboratorio;
import Logo from '../components/marca/Logo.astro';
import { loja, enderecoCompleto } from '../config/loja';
---
<Layout title="Direção visual institucional | Smart Lion" description="Estudo visual da remodelagem institucional da Smart Lion, em Lages.">
 <section class="abertura"><Picture src={lojaFoto} alt="Interior da Smart Lion com balcão de madeira e prateleiras iluminadas" formats={['avif','webp']} widths={[480,800,1280,1920]} sizes="100vw" loading="eager" fetchpriority="high"/><div class="container abertura-texto"><p class="eyebrow">A casa do leão · estudo visual R1</p><h1>Tecnologia com procedência,<br/><em>no coração de Lages.</em></h1><p class="resposta">Na {loja.nome}, reunimos produtos, assistência técnica e formação na {enderecoCompleto}. Conheça nosso espaço e fale com a gente pelo WhatsApp.</p><div class="acoes"><a class="button button-light" href="/visite-nos">Conheça a loja ↗</a><BotaoWhatsApp discreto/></div><StatusHorario/></div><div class="container legenda">O ambiente real da Smart Lion. Fotografia existente do interior.</div></section>
 <Capitulo id="manifesto-estilo" marcador="01 / A ideia" titulo="Tecnologia de verdade é sobre pessoas."><p slot="introducao">Queremos tornar a experiência com tecnologia segura e confiável. Procedência, atendimento e suporte fazem parte dessa relação.</p><div class="editorial"><RevelacaoImagem src={lojaFoto} alt="Balcão de madeira e prateleiras no interior da Smart Lion" legenda="Um lugar para conhecer, conversar e escolher."/><div><p class="eyebrow">Um espaço, diferentes caminhos</p><p class="texto-grande">Da escolha de um aparelho ao cuidado com ele.</p><a class="link-editorial" href="/assistencia-tecnica">Conheça a assistência ↗</a></div></div></Capitulo>
 <Capitulo id="fontes" tema="claro" marcador="02 / Comparação tipográfica" titulo="Duas vozes para a mesma história."><p slot="introducao">A: DM Serif Display + DM Sans. B: Young Serif + DM Sans. O mesmo leão, texto e proporção para comparar. A fonte B é carregada somente nesta página de estudo.</p><div class="comparacao">{['a','b'].map((par,index)=><article class={`amostra fonte-${par}`}><div class="amostra-topo"><Logo variante="leao" titulo="Leão da Smart Lion" class="leao-estudo"/><span>{index===0?'A · DM Serif Display':'B · Young Serif'}</span></div><h3>Tecnologia com procedência, no coração de Lages.</h3><p>Tecnologia de verdade é sobre pessoas.</p><p class="numero">5,0</p><p>Atendimento de perto. Conheça a loja e fale com a nossa equipe.</p></article>)}</div></Capitulo>
 <Capitulo id="ambientes-estilo" marcador="03 / Fotografia e movimento" titulo="Espaço para cuidar. Espaço para aprender."><p slot="introducao">Fotos reais, reveladas uma vez. Sem JavaScript ou com movimento reduzido, continuam visíveis.</p><div class="ambientes"><RevelacaoImagem src={bancada} alt="Bancada de manutenção da Smart Lion" legenda="Assistência técnica" sizes="(max-width: 700px) 100vw, 45vw"/><RevelacaoImagem src={laboratorio} alt="Bancadas do laboratório de treinamento da Smart Lion" legenda="Centro Técnico" sizes="(max-width: 700px) 100vw, 45vw"/></div></Capitulo>
 <Capitulo id="elementos" tema="claro" marcador="04 / Elementos e contraste" titulo="O essencial, à vista."><p slot="introducao">Paleta quente, contato discreto e foco visível. As mensagens do WhatsApp permanecem centralizadas.</p><div class="paleta">{[['Grafite','#111214'],['Off-white','#f5f3ef'],['Madeira','#8a6a4f'],['Magenta','#e0157a'],['WhatsApp','#25d366']].map(([nome,cor])=><div><span style={`background:${cor}`} aria-hidden="true"></span><p>{nome}<br/><code>{cor}</code></p></div>)}</div><div class="acoes"><BotaoWhatsApp/><a class="button" href="/avaliacoes">Leia as avaliações ↗</a><a class="link-editorial" href={loja.instagram.url}>{loja.instagram.nome} ↗</a></div><p class="nota">Use Tab para conferir os focos e Escape para fechar o submenu “O que fazemos”. O horário e os contatos completos estão no rodapé.</p></Capitulo>
</Layout>
<style>
@font-face{font-family:'Young Serif';src:url('@fontsource/young-serif/files/young-serif-latin-400-normal.woff2') format('woff2');font-weight:400;font-display:swap}.abertura{position:relative;isolation:isolate;padding:clamp(64px,8vw,120px) 0 28px;min-height:760px;display:flex;flex-direction:column;justify-content:center}.abertura :global(picture){position:absolute;inset:0;z-index:-2}.abertura :global(picture img){width:100%;height:100%;object-fit:cover;object-position:center}.abertura:before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#111214f5 0%,#111214df 48%,#11121425 100%)}h1{max-width:890px;margin:28px 0;line-height:1.04}h1 em{font-style:normal;color:#ded1c2}.resposta{max-width:580px;font-size:1rem;color:#e2e0dc}.acoes{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:28px}.legenda{padding-top:60px;font-size:.75rem;color:#ded1c2}.editorial{display:grid;grid-template-columns:1.5fr 1fr;align-items:center;gap:clamp(32px,6vw,96px)}.texto-grande{font:400 clamp(1.8rem,3vw,3rem)/1.2 var(--font-heading);margin:24px 0 32px}.link-editorial{display:inline-flex;align-items:center;min-height:48px;text-decoration:underline;text-underline-offset:6px}.comparacao{display:grid;grid-template-columns:1fr 1fr;gap:32px}.amostra{padding:clamp(24px,3vw,44px);background:var(--ink);color:var(--white);border-top:3px solid var(--wood)}.amostra-topo :global(.leao-estudo){width:56px}.amostra-topo{display:flex;align-items:center;gap:16px;font-size:.8rem;margin-bottom:40px}.amostra h3{font-size:clamp(1.8rem,3.1vw,3.4rem)}.amostra>p{margin-top:24px}.amostra .numero{font:400 5rem/1 var(--font-heading);font-variant-numeric:tabular-nums}.fonte-b h3,.fonte-b .numero{font-family:'Young Serif',Georgia,serif}.ambientes{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,8vw,120px)}.ambientes>:last-child{margin-top:100px}.paleta{display:flex;flex-wrap:wrap;gap:32px}.paleta>div{flex:1;min-width:120px}.paleta span{display:block;height:72px;border:1px solid #777;margin-bottom:16px}.paleta p{font-size:.85rem}.nota{font-size:.85rem;color:var(--text-dark);max-width:650px;margin-top:32px}@media(max-width:700px){.abertura{min-height:700px;padding-top:64px}.abertura:before{background:#111214df}.abertura h1{font-size:clamp(2.5rem,9vw,3.5rem)}.editorial,.comparacao,.ambientes{grid-template-columns:1fr}.ambientes>:last-child{margin-top:12px}.amostra h3{font-size:2.2rem}.legenda{padding-top:40px}}
</style>
