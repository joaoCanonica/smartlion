---
// Estudo tipográfico da remodelagem premium (P0). Página noindex, fora do sitemap.
// Carrega as cinco famílias candidatas só aqui; o resto do site não baixa nenhuma delas.
export function getStaticPaths(){ return [{ params: { premium: '_estudo-premium' } }]; }
import Layout from '../layouts/LayoutBase.astro';
import { loja } from '../config/loja';
import { resumoAvaliacoes } from '../lib/avaliacoes';
const nota = resumoAvaliacoes.nota.toFixed(1).replace('.', ',');
const total = String(resumoAvaliacoes.total);
const candidatos = [
  { id: 'a', titulo: 'Sora', texto: 'Inter Tight', nota: 'A · escolhida' },
  { id: 'b', titulo: 'Geist', texto: 'Geist', nota: 'B' },
  { id: 'c', titulo: 'Outfit', texto: 'Inter Tight', nota: 'C' },
];
const paragrafo = `Começamos com produtos novos e seminovos com nota fiscal. Nossa atuação se ampliou para a manutenção de celulares e o treinamento técnico, reunindo venda, suporte e aprendizado no mesmo endereço. ${loja.irpDescricao}. Nossos iPhones seminovos passam pela avaliação da equipe técnica e contam com ${loja.garantiaSeminovosMeses} meses de garantia da loja. Consulte as condições de cobertura antes da compra.`;
---
<Layout title="Estudo tipográfico premium | Smart Lion" description="Estudo interno de tipografia da remodelagem premium da Smart Lion.">
  <div class="estudo">
    <header class="topo">
      <h1 class="rotulo">P0 · Estudo tipográfico · Leão de Aço</h1>
      <p class="aviso">Página interna (noindex). Mesmo texto, mesmo tamanho e mesma cor para comparar as três combinações. Rótulos em Michroma nas três colunas.</p>
    </header>
    <section aria-labelledby="t-hero"><h2 id="t-hero" class="rotulo secao">01 · Hero</h2>
      <div class="grade">{candidatos.map(c => <article class={`prova fonte-${c.id}`}><p class="rotulo">{c.nota} · {c.titulo} + {c.texto}</p><p class="hero">Tecnologia com procedência.</p><p class="apoio">Venda, assistência e ensino no Centro de Lages.</p></article>)}</div>
    </section>
    <section aria-labelledby="t-numero"><h2 id="t-numero" class="rotulo secao">02 · Número grande</h2>
      <div class="grade">
        {candidatos.map(c => <article class={`prova fonte-${c.id}`}><p class="rotulo">{c.titulo}</p><div class="numeros"><p><span class="numero">{nota}</span><span class="legenda">nota no Google</span></p><p><span class="numero">{total}</span><span class="legenda">avaliações</span></p></div></article>)}
        <article class="prova fonte-m"><p class="rotulo">Michroma (proposta para números)</p><div class="numeros"><p><span class="numero">{nota}</span><span class="legenda">nota no Google</span></p><p><span class="numero">{total}</span><span class="legenda">avaliações</span></p></div></article>
      </div>
    </section>
    <section aria-labelledby="t-texto"><h2 id="t-texto" class="rotulo secao">03 · Parágrafo longo</h2>
      <div class="grade dois">
        <article class="prova texto-inter"><p class="rotulo">Inter Tight · 17 px / 1,6</p><p class="paragrafo">{paragrafo}</p></article>
        <article class="prova texto-geist"><p class="rotulo">Geist · 17 px / 1,6</p><p class="paragrafo">{paragrafo}</p></article>
      </div>
    </section>
  </div>
</Layout>
<style>
/* Sora, Inter Tight e Michroma vêm de tokens.css; aqui só as candidatas não escolhidas. */
@font-face{font-family:'Geist Variable';src:url('@fontsource-variable/geist/files/geist-latin-wght-normal.woff2') format('woff2-variations');font-weight:100 900;font-display:swap}
@font-face{font-family:'Outfit';src:url('@fontsource/outfit/files/outfit-latin-600-normal.woff2') format('woff2');font-weight:600;font-display:swap}
@font-face{font-family:'Outfit';src:url('@fontsource/outfit/files/outfit-latin-400-normal.woff2') format('woff2');font-weight:400;font-display:swap}
.estudo{--f:var(--cor-fundo);background:var(--cor-fundo);color:var(--cor-texto);padding:clamp(32px,6vw,96px) clamp(16px,4vw,64px);display:grid;gap:clamp(40px,6vw,80px)}
.topo{display:grid;gap:12px;max-width:70ch}.aviso{color:var(--cor-texto-2);font:400 .95rem/1.6 'Inter Tight Variable',sans-serif}
.rotulo{font:400 .7rem/1.4 'Michroma',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--cor-texto-2)}
.rotulo.secao{color:var(--cor-acento);margin-bottom:20px}
.grade{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px}.grade.dois{grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))}
.prova{background:var(--cor-superficie);border:1px solid var(--cor-borda);border-radius:var(--raio-md);padding:clamp(20px,3vw,36px);display:grid;gap:18px;align-content:start}
.hero{font-size:clamp(2.2rem,4.2vw,3.6rem);line-height:1.02;letter-spacing:-.035em;font-weight:600;text-wrap:balance}
.apoio{color:var(--cor-texto-2);font-size:1.05rem;line-height:1.5}
.numeros{display:flex;flex-wrap:wrap;gap:28px 36px}.numeros p{display:grid;gap:6px}
.numero{font-size:clamp(3rem,6vw,5rem);line-height:1;color:var(--cor-acento);font-variant-numeric:tabular-nums;font-weight:600;letter-spacing:-.02em}
.legenda{font:400 .65rem/1.4 'Michroma',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--cor-texto-2)}
.paragrafo{font-size:1.0625rem;line-height:1.6;max-width:62ch;color:var(--cor-texto)}
.fonte-a .hero,.fonte-a .numero{font-family:'Sora Variable',sans-serif}.fonte-a .apoio{font-family:'Inter Tight Variable',sans-serif}
.fonte-b .hero,.fonte-b .numero,.fonte-b .apoio{font-family:'Geist Variable',sans-serif}
.fonte-c .hero,.fonte-c .numero{font-family:'Outfit',sans-serif}.fonte-c .apoio{font-family:'Inter Tight Variable',sans-serif}
.fonte-m .numero{font-family:'Michroma',sans-serif;font-weight:400;font-size:clamp(2.4rem,4.6vw,4rem);letter-spacing:0}
.texto-inter .paragrafo{font-family:'Inter Tight Variable',sans-serif}.texto-geist .paragrafo{font-family:'Geist Variable',sans-serif}
</style>
