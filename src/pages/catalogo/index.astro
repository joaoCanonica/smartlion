---
import LinhasVitrine from '../../components/catalogo/LinhasVitrine.astro';
import AberturaVitrine from '../../components/catalogo/AberturaVitrine.astro';
import Layout from '../../layouts/LayoutBase.astro';
import ParcelamentoHome from '../../components/home/ParcelamentoHome.astro';
import Catalogo from '../../components/catalogo/Catalogo.astro';
import { obterProdutos } from '../../lib/produtos';
const produtos=await obterProdutos();
---
<Layout title="Catálogo de iPhone e importados em Lages | Smart Lion" description="Explore as categorias da Smart Lion em Lages. Consulte versões, cores e condições pelo WhatsApp."><section class="catalogo"><div class="container"><AberturaVitrine/><LinhasVitrine/><Catalogo produtos={produtos}/></div></section><ParcelamentoHome/></Layout>
<style>.catalogo,.categoria{padding:0 0 var(--espaco-secao)}</style>
