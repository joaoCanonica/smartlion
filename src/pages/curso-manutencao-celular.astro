---
import Pagina from '../layouts/PaginaInstitucional.astro';
import { loja,enderecoCompleto } from '../config/loja';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { mensagensWhatsApp } from '../config/whatsapp';
import { Picture } from 'astro:assets';
import foto from '../assets/home/laboratorio.jpg';
---
<Pagina editorial titulo="Curso de manutenção de celulares em Lages" descricao="Conheça o Centro Técnico Smart Lion em Lages. Laboratório com bancadas individuais e informações sobre as próximas turmas pelo WhatsApp." resposta={`O Centro Técnico da ${loja.nome} oferece treinamento em manutenção de celulares no laboratório anexo à loja, na ${enderecoCompleto}. Consulte a próxima turma e as condições pelo WhatsApp.`}>
<BotaoWhatsApp slot="acao" texto={mensagensWhatsApp.curso()} rotulo="Quero saber da próxima turma"/>
<figure slot="foto"><Picture src={foto} formats={['avif','webp']} widths={[420,640,900]} sizes="(max-width:800px) 100vw, 45vw" alt="Laboratório de treinamento Smart Lion com bancadas individuais" loading="eager" class="foto-editorial"/><figcaption>Bancadas individuais do Centro Técnico.</figcaption></figure>
<section class="pagina-bloco light"><div class="container duas-colunas"><div><h2>Teoria e prática na bancada.</h2><p>Um espaço para quem deseja começar na manutenção de celulares ou aperfeiçoar seus conhecimentos.</p><p>O laboratório conta com bancadas individuais e estrutura voltada ao aprendizado prático.</p></div><div><h3>Antes de se inscrever</h3><ul><li>Consulte conteúdo e pré-requisitos.</li><li>Confirme datas, horários e carga horária.</li><li>Pergunte sobre materiais, certificado e investimento.</li></ul><p>Essas informações são confirmadas diretamente com a equipe para cada turma.</p><BotaoWhatsApp texto={mensagensWhatsApp.curso()} rotulo="Conversar sobre o curso"/><nav class="navegacao-paginas" aria-label="Visite o Centro Técnico"><a href="/visite-nos">Como chegar ↗</a></nav></div></div></section>
</Pagina>
