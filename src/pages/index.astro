---
/**
 * Home (P4). Cada seção tem um gesto próprio; nenhuma foto se repete (ver docs/premium/P4.md).
 * Ordem (§7): abertura · hero · prova · chegou na loja · o que fazemos · por dentro do reparo ·
 * a loja · linhas de produto · o que dizem · marcas · nossa história · Instagram · visite-nos.
 */
import Layout from '../layouts/LayoutBase.astro';
import AberturaInicio from '../components/abertura/AberturaInicio.astro';
import AberturaModelo from '../components/abertura/AberturaModelo.astro';
import HeroLeao from '../components/hero/HeroLeao.astro';
import ProvaHero from '../components/hero/ProvaHero.astro';
import ChegouNaLoja from '../components/home/ChegouNaLoja.astro';
import OQueFazemos from '../components/home/OQueFazemos.astro';
import PorDentroDoReparo from '../components/home/PorDentroDoReparo.astro';
import GaleriaLoja from '../components/home/GaleriaLoja.astro';
import LinhasProduto from '../components/home/LinhasProduto.astro';
import OQueDizem from '../components/home/OQueDizem.astro';
import MarquiseMarcas from '../components/home/MarquiseMarcas.astro';
import HistoriaHome from '../components/home/HistoriaHome.astro';
import InstagramHome from '../components/home/InstagramHome.astro';
import LojaHome from '../components/home/LojaHome.astro';
// Fotos já usadas nesta página (O que fazemos + A loja): o Instagram não as repete.
const fotosUsadas = ['fones', 'bancada', 'laboratorio', 'loja', 'caixas-de-som', 'capas'];
---
<Layout title="Smart Lion em Lages | Produtos, assistência e Centro Técnico" description="Conheça a Smart Lion no Centro de Lages: Apple, Xiaomi, importados, seminovos, assistência técnica e curso de manutenção. Veja a loja e fale conosco.">
<AberturaInicio/>
<HeroLeao/>
<ProvaHero/>
<ChegouNaLoja/>
<OQueFazemos/>
<PorDentroDoReparo/>
<GaleriaLoja/>
<LinhasProduto/>
<OQueDizem/>
<MarquiseMarcas/>
<HistoriaHome/>
<InstagramHome fotosUsadas={fotosUsadas}/>
<LojaHome/>
<AberturaModelo/>
</Layout>
<style is:global>
/* Seções abaixo do hero: o navegador pula o layout e a pintura enquanto estão fora da tela.
   Além de poupar CPU, as fotos lazy dessas seções só são pedidas depois da primeira pintura
   do hero, sem disputar banda com o LCP. A altura estimada evita saltos na barra de rolagem. */
#atividades,#reparo,#ambiente,#vitrine,#depoimentos,#historia,#instagram,#visite-nos{content-visibility:auto;contain-intrinsic-size:auto 1100px}
</style>
