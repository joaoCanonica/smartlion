{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/como-chegar",
      "destination": "/visite-nos",
      "statusCode": 301
    },
    {
      "source": "/sobre",
      "destination": "/nossa-historia",
      "statusCode": 301
    },
    {
      "source": "/catalogo",
      "destination": "/produtos",
      "statusCode": 301
    },
    {
      "source": "/produtos/seminovos",
      "destination": "/seminovos",
      "statusCode": 301
    },
    {
      "source": "/catalogo/iphone",
      "destination": "/produtos/iphone",
      "statusCode": 301
    },
    {
      "source": "/catalogo/seminovos",
      "destination": "/seminovos",
      "statusCode": 301
    },
    {
      "source": "/catalogo/ipad-mac-watch",
      "destination": "/produtos/ipad-mac-watch",
      "statusCode": 301
    },
    {
      "source": "/catalogo/xiaomi",
      "destination": "/produtos/xiaomi",
      "statusCode": 301
    },
    {
      "source": "/catalogo/casa-e-games",
      "destination": "/produtos/casa-e-games",
      "statusCode": 301
    },
    {
      "source": "/catalogo/acessorios",
      "destination": "/produtos/acessorios",
      "statusCode": 301
    },
    {
      "source": "/catalogo/perfumaria",
      "destination": "/produtos/perfumaria",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(self), accelerometer=(self), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(marca.svg|favicon.svg|favicon-32.png|apple-touch-icon.png|manifest.webmanifest|busca.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
